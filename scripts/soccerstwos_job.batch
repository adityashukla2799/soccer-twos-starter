#!/bin/bash

# Soccer Twos RL Training Job Example Batch Script for PACE
# Author: Mili Das
# Date: 2026

# Replace gburdell3 with your GT username.
# Replace the training script name with the actual script you want to run.

#SBATCH --job-name=soccer_augobs
#SBATCH -N1 --ntasks-per-node=8
#SBATCH --mem-per-cpu=64G
#SBATCH -t08:00:00
#SBATCH --output=soccerstwos-%j.out
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=ashukla301@gatech.edu

source ~/miniconda3/etc/profile.d/conda.sh
conda activate soccerstwos

# Run the training script
cd scratch/drl_soccertwos/soccer-twos-starter

python train_ppo_sp_augobs_curriculum.py